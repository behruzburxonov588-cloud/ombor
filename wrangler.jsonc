// OMBOR PRO — Cloudflare Workers (faqat statik sayt).
// Har bir GitHub push'dan keyin Cloudflare shu faylni o'qiydi:
// ombor-pro papkasida kutubxonalarni o'rnatadi, saytni yig'adi va ombor-pro/dist ni joylaydi.
// Ma'lumotlar bazasi — Supabase (kalitlar ombor-pro/.env.production faylida).
{
  "name": "ombor-pro",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm ci --prefix ombor-pro --no-audit --no-fund && npm run build --prefix ombor-pro"
  },
  "assets": {
    "directory": "ombor-pro/dist",
    "not_found_handling": "single-page-application"
  }
}
