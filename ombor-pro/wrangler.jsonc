// OMBOR PRO — Cloudflare Workers sozlamasi.
// Maxfiy qiymatlar (JWT_SECRET, DATABASE_URL) bu faylga YOZILMAYDI: ular Cloudflare panelida
// Worker → Settings → Variables and Secrets bo'limida "Secret" sifatida kiritiladi.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ombor-pro",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Sahifa, stil, skript, shrift va ikonkalar Cloudflare tomonidan beriladi;
  // faqat API va rasmlar Worker'ga keladi
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  // Bildirishnomalar va rejali xulosalar soatiga bir marta tekshiriladi (bepul bazaning
  // "uyg'oq vaqt" limitini tejash uchun). Ilova ochiq bo'lsa, xabarlar har daqiqada yangilanadi.
  "triggers": { "crons": ["0 * * * *"] },

  "vars": {
    "NODE_ENV": "production"
  },

  // Migratsiyalar va PDF shriftlari Worker to'plamiga qo'shiladi
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  "observability": { "enabled": true },

  // Tezlik: Worker foydalanuvchi yonida emas, ma'lumotlar bazasi (Neon, Frankfurt — aws:eu-central-1) yonida ishlaydi.
  // Har bir sahifa bazaga bir necha marta murojaat qiladi; ular endi bir shahar ichida bajariladi.
  // O'lchov: Worker AQShda ishlaganda bazaga ulanish ~650 ms edi; bazaning yonida ~20 ms.
  // Neon loyihasi boshqa mintaqaga ko'chirilsa, shu qiymatni ham o'zgartiring (javobdagi Server-Timing → db).
  "placement": { "region": "aws:eu-central-1" }

  // DIQQAT: Hyperdrive ulamang. U har bir do'kon sxemasiga o'tishni saqlamaydi va do'konlar ma'lumoti aralashishi mumkin.
}
