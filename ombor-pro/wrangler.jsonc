// OMBOR PRO — Cloudflare Workers sozlamasi.
// Maxfiy qiymatlar (JWT_SECRET, DATABASE_URL) bu faylga YOZILMAYDI: ular Cloudflare panelida
// Worker → Settings → Variables and Secrets bo'limida "Secret" sifatida kiritiladi.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ombor-pro",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Sahifa, stil, skript, shrift va ikonkalar Cloudflare tomonidan beriladi;
  // faqat API va rasmlar Worker'ga keladi
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  // Bildirishnomalar va rejali xulosalar har daqiqada tekshiriladi
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "NODE_ENV": "production"
  },

  // Migratsiyalar va PDF shriftlari Worker to'plamiga qo'shiladi
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  "observability": { "enabled": true }

  // Ixtiyoriy (tezroq ishlash uchun): Cloudflare Hyperdrive yaratib, ID sini shu yerga qo'shing:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }]
}
